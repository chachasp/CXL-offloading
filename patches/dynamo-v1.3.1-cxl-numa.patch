+#[cfg(target_os = "linux")]
+const MPOL_BIND: libc::c_int = 2;
+
+#[cfg(target_os = "linux")]
+unsafe fn mbind(addr: *mut libc::c_void, len: usize, node: u32) -> std::result::Result<(), String> {
+    let bits_per_word = usize::BITS as usize;
+    let words = (node as usize / bits_per_word) + 1;
+    let mut nodemask = vec![0usize; words];
+    nodemask[node as usize / bits_per_word] |= 1usize << (node as usize % bits_per_word);
+    let maxnode = words * bits_per_word;
+
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_mbind,
+            addr,
+            len,
+            MPOL_BIND,
+            nodemask.as_ptr(),
+            maxnode,
+            0usize,
+        )
+    };
+    if rc != 0 {
+        return Err(format!(
+            "mbind(MPOL_BIND) to NUMA node {node} failed: {}",
+            std::io::Error::last_os_error()
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+fn bind_range_to_node(
+    addr: *mut libc::c_void,
+    len: usize,
+    node: u32,
+) -> std::result::Result<(), String> {
+    let node_path = format!("/sys/devices/system/node/node{node}");
+    if !std::path::Path::new(&node_path).is_dir() {
+        return Err(format!("configured CXL NUMA node {node} does not exist"));
+    }
+    unsafe { mbind(addr, len, node) }
+}
+
+#[cfg(target_os = "linux")]
+unsafe fn fault_all_pages(ptr: *mut u8, len: usize) {
+    let page_size = match unsafe { libc::sysconf(libc::_SC_PAGESIZE) } {
+        value if value > 0 => value as usize,
+        _ => 4096,
+    };
+    let mut offset = 0usize;
+    while offset < len {
+        unsafe { std::ptr::write_volatile(ptr.add(offset), 0) };
+        offset = offset.saturating_add(page_size);
+    }
+    if !len.is_multiple_of(page_size) {
+        unsafe { std::ptr::write_volatile(ptr.add(len - 1), 0) };
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn verify_all_pages_on_node(
+    ptr: *mut u8,
+    len: usize,
+    expected_node: u32,
+) -> std::result::Result<(), String> {
+    let page_size = match unsafe { libc::sysconf(libc::_SC_PAGESIZE) } {
+        value if value > 0 => value as usize,
+        _ => 4096,
+    };
+    let page_count = len.div_ceil(page_size);
+    const BATCH_PAGES: usize = 4096;
+    let mut first_bad: Option<(usize, i32)> = None;
+    let mut checked = 0usize;
+
+    while checked < page_count {
+        let count = (page_count - checked).min(BATCH_PAGES);
+        let mut pages = Vec::with_capacity(count);
+        for index in 0..count {
+            pages.push(unsafe { ptr.add((checked + index) * page_size) }.cast::<libc::c_void>());
+        }
+        let mut status = vec![-1i32; count];
+        let rc = unsafe {
+            libc::syscall(
+                libc::SYS_move_pages,
+                0,
+                count,
+                pages.as_ptr(),
+                std::ptr::null::<libc::c_int>(),
+                status.as_mut_ptr(),
+                0,
+            )
         };
+        if rc < 0 {
+            return Err(format!(
+                "move_pages placement query failed after {checked} pages: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        for (index, actual) in status.into_iter().enumerate() {
+            if actual != expected_node as i32 {
+                first_bad = Some((checked + index, actual));
+                break;
+            }
+        }
+        if first_bad.is_some() {
+            break;
+        }
+        checked += count;
+    }
+
+    if let Some((page, actual)) = first_bad {
+        return Err(format!(
+            "strict CXL placement failed: page {page} is on NUMA node/status {actual}, expected {expected_node}; DRAM fallback is forbidden"
+        ));
     }
+    Ok(())
 }

