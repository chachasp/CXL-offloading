+    /// verifies every page with `move_pages`, and only then registers the
+    /// region with CUDA. It never falls back to another NUMA node.
+    #[cfg(target_os = "linux")]
+    pub fn new_cxl_numa(len: usize, device_id: u32, node: u32) -> Result<Self> {
+        if len == 0 {
+            return Err(StorageError::AllocationFailed(
+                "zero-sized CXL NUMA allocations are not supported".into(),
+            ));
+        }
+
+        let ctx = crate::device::cuda_context(device_id)?;
+        unsafe {
+            ctx.bind_to_thread().map_err(StorageError::Cuda)?;
+        }
+
+        let ptr = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            )
+        };
