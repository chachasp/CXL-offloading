+#[cfg(target_os = "linux")]
+fn cxl_numa_node_from_env() -> Result<Option<u32>, StorageError> {
+    const VARIABLE: &str = "DYN_KVBM_CXL_NUMA_NODE";
+    let Ok(value) = std::env::var(VARIABLE) else {
+        return Ok(None);
+    };
+    let value = value.trim();
+    if value.is_empty() {
+        return Err(StorageError::AllocationFailed(format!(
+            "{VARIABLE} is set but empty"
+        )));
+    }
+    let node = value.parse::<u32>().map_err(|_| {
+        StorageError::AllocationFailed(format!(
+            "{VARIABLE} must be an explicit numeric memory-only NUMA node, got {value:?}"
+        ))
+    })?;
+    let node_path = format!("/sys/devices/system/node/node{node}");
+    let cpulist = std::fs::read_to_string(format!("{node_path}/cpulist")).map_err(|error| {
+        StorageError::AllocationFailed(format!(
+            "cannot read {node_path}/cpulist for CXL validation: {error}"
+        ))
+    })?;
+    if !cpulist.trim().is_empty() {
+        return Err(StorageError::AllocationFailed(format!(
+            "NUMA node {node} owns CPUs ({cpulist:?}); strict CXL-only mode requires a memory-only node with an empty cpulist"
+        )));
+    }
+    Ok(Some(node))
+}
+
+#[cfg(not(target_os = "linux"))]
+fn cxl_numa_node_from_env() -> Result<Option<u32>, StorageError> {
+    if std::env::var_os("DYN_KVBM_CXL_NUMA_NODE").is_some() {
+        return Err(StorageError::InvalidConfig(
+            "DYN_KVBM_CXL_NUMA_NODE is supported only on Linux".into(),
+        ));
     }
+    Ok(None)
 }

