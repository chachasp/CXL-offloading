+            if registered {
+                let _ = cudarc::driver::sys::cuMemHostUnregister(ptr);
+            }
+            let _ = libc::munmap(ptr, len);
+        };
+
+        if let Err(error) = bind_range_to_node(ptr, len, node) {
+            cleanup(false);
+            return Err(StorageError::AllocationFailed(error));
+        }
+
